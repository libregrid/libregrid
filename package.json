{
  "name": "@libregrid/source",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Enterprise-grade features for AG Grid Community",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libregrid/libregrid.git"
  },
  "bugs": { "url": "https://github.com/libregrid/libregrid/issues" },
  "homepage": "https://github.com/libregrid/libregrid#readme",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "verify": "npm run lint && npm run test && npm run build && npm run check:contamination && npm run check:versions",
    "check:contamination": "node tools/check-contamination/bin.mjs",
    "check:versions": "node tools/version/check.mjs",
    "gen:version": "node tools/version/generate.mjs",
    "docs": "npm -w apps/docs run dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "ag-grid-community": "36.1.0",
    "jsdom": "^25.0.0",
    "nx": "^21.0.0",
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  },
  "engines": { "node": ">=20.19.0" }
}
