{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": [
    "type:angular"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "outputPath": "apps/docs/dist",
        "index": "apps/docs/src/index.html",
        "browser": "apps/docs/src/main.ts",
        "tsConfig": "apps/docs/tsconfig.app.json",
        "styles": [
          "apps/docs/src/assets/vendor/klaro/klaro.min.css",
          "apps/docs/src/styles.scss"
        ],
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/docs/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "apps/docs/examples",
            "output": "examples"
          }
        ],
        "polyfills": [
          "zone.js"
        ]
      },
      "configurations": {
        "production": {},
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "prebundle": {
          "exclude": [
            "@libregrid/calculated-columns",
            "@libregrid/formulas",
            "@libregrid/cell-selection"
          ]
        },
        "proxyConfig": "apps/docs/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "docs:build:production"
        },
        "development": {
          "buildTarget": "docs:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "validate-examples": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/docs-examples/validate.mjs"
      }
    }
  }
}
