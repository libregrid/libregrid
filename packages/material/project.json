{
  "name": "material",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": ["type:angular"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.lib.json",
        "cwd": "packages/material"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx ng test material --watch=false",
        "cwd": "."
      }
    }
  }
}
