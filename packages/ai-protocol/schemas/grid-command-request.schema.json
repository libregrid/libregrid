{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libregrid.dev/schemas/ai/v1/grid-command-request.schema.json",
  "title": "LibreGrid Grid Command Request",
  "type": "object",
  "properties": {
    "protocol": { "const": "libregrid.ai/v1" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "command": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "gridSchema": { "type": "object" },
    "currentState": { "type": "object" },
    "context": {
      "type": "object",
      "properties": {
        "currentPage": { "type": "integer", "minimum": 0 },
        "density": { "type": "string" },
        "pageSize": { "type": "integer", "minimum": 1 },
        "totalRecordCount": { "type": "integer", "minimum": 0 },
        "facts": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "required": ["protocol", "requestId", "revision", "command", "gridSchema", "currentState", "context"],
  "additionalProperties": false
}
