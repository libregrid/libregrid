{
  "name": "ai-toolkit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": ["type:framework-neutral"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../tools/clean-package-dist.mjs ai-toolkit && tsc -p tsconfig.lib.json",
        "cwd": "packages/ai-toolkit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run packages/ai-toolkit"
      }
    }
  }
}
