{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@libregrid/core": ["./packages/core/src/index.ts"],
      "@libregrid/core/testing": ["./packages/core/src/testing/index.ts"],
      "@libregrid/menu": ["./packages/menu/src/index.ts"],
      "@libregrid/notes": ["./packages/notes/src/index.ts"],
      "@libregrid/side-bar": ["./packages/side-bar/src/index.ts"],
      "@libregrid/material": ["./packages/material/src/index.ts"],
      "@libregrid/row-grouping": ["./packages/row-grouping/src/index.ts"],
      "@libregrid/pivot": ["./packages/pivot/src/index.ts"],
      "@libregrid/server-side-row-model": ["./packages/server-side-row-model/src/index.ts"],
      "@libregrid/server-side-selection": ["./packages/server-side-selection/src/index.ts"],
      "@libregrid/viewport-row-model": ["./packages/viewport-row-model/src/index.ts"],
      "@libregrid/tree-data": ["./packages/tree-data/src/index.ts"],
      "@libregrid/master-detail": ["./packages/master-detail/src/index.ts"],
      "@libregrid/columns-tool-panel": ["./packages/columns-tool-panel/src/index.ts"],
      "@libregrid/set-filter": ["./packages/set-filter/src/index.ts"],
      "@libregrid/multi-filter": ["./packages/multi-filter/src/index.ts"],
      "@libregrid/filters-tool-panel": ["./packages/filters-tool-panel/src/index.ts"],
      "@libregrid/cell-selection": ["./packages/cell-selection/src/index.ts"],
      "@libregrid/row-numbers": ["./packages/row-numbers/src/index.ts"],
      "@libregrid/column-header-edit": ["./packages/column-header-edit/src/index.ts"],
      "@libregrid/clipboard": ["./packages/clipboard/src/index.ts"],
      "@libregrid/status-bar": ["./packages/status-bar/src/index.ts"],
      "@libregrid/toolbar": ["./packages/toolbar/src/index.ts"],
      "@libregrid/excel-export": ["./packages/excel-export/src/index.ts"],
      "@libregrid/advanced-filter": ["./packages/advanced-filter/src/index.ts"],
      "@libregrid/find": ["./packages/find/src/index.ts"],
      "@libregrid/rich-select": ["./packages/rich-select/src/index.ts"],
      "@libregrid/integrated-charts": ["./packages/integrated-charts/src/index.ts"],
      "@libregrid/sparklines": ["./packages/sparklines/src/index.ts"],
      "@libregrid/angular": ["./packages/angular/src/index.ts"],
      "@libregrid/all": ["./packages/all/src/index.ts"],
      "@libregrid/batch-edit": ["./packages/batch-edit/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
