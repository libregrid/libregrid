{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "projects": {
    "docs": {
      "projectType": "application",
      "root": "apps/docs",
      "sourceRoot": "apps/docs/src",
      "prefix": "lgr",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "apps/docs/dist",
            "browser": "apps/docs/src/main.ts",
            "index": "apps/docs/src/index.html",
            "tsConfig": "apps/docs/tsconfig.app.json",
            "styles": ["apps/docs/src/styles.scss"],
            "assets": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3.5mb",
                  "maximumError": "4.5mb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "prebundle": {
              "exclude": ["@libregrid/calculated-columns"]
            }
          },
          "configurations": {
            "production": { "buildTarget": "docs:build:production" },
            "development": { "buildTarget": "docs:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "material": {
      "projectType": "library",
      "root": "packages/material",
      "sourceRoot": "packages/material/src",
      "prefix": "lgr",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "packages/material/dist-test-build",
            "browser": "packages/material/src/test-bootstrap.ts",
            "tsConfig": "packages/material/tsconfig.spec.json",
            "polyfills": ["zone.js"]
          },
          "configurations": {
            "development": { "optimization": false }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "packages/material/tsconfig.spec.json",
            "runner": "vitest",
            "runnerConfig": "packages/material/vitest.config.ts",
            "include": ["packages/material/src/**/*.spec.ts"],
            "coverage": true,
            "coverageInclude": ["packages/material/src/**/*.ts"],
            "coverageExclude": [
              "packages/material/src/**/*.spec.ts",
              "packages/material/src/version.ts",
              "packages/material/src/index.ts"
            ],
            "coverageReporters": ["text-summary"],
            "coverageThresholds": {
              "statements": 85,
              "branches": 75,
              "functions": 85,
              "lines": 85
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
